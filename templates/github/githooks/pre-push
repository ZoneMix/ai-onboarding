#!/usr/bin/env bash
# pre-push: run the project's checks before anything leaves this machine.
# Turn it on once per clone, from the repo root:  git config core.hooksPath .githooks
# Edit CHECKS to match the commands in AGENTS.md. A failing check blocks the push.
set -euo pipefail

CHECKS=(
  "echo replace with your lint command"
  "echo replace with your test command"
)
ZERO=0000000000000000000000000000000000000000

cd "$(git rev-parse --show-toplevel)"

# Skip pure branch deletions: nothing new is being pushed.
pushing=0
while read -r _localref localsha _remoteref _remotesha; do
  [ "${localsha:-$ZERO}" != "$ZERO" ] && pushing=1
done
[ "$pushing" -eq 1 ] || exit 0

# Tests must not inherit git's hook environment: with GIT_DIR set, a test that builds a
# throwaway repo writes into this one instead.
while IFS= read -r var; do unset "$var"; done < <(env | sed -n 's/^\(GIT_[A-Z_]*\)=.*/\1/p')

for check in "${CHECKS[@]}"; do
  echo "pre-push: $check"
  if ! bash -c "$check"; then
    echo "pre-push: failed: $check. Push aborted; fix it rather than skipping the hook." >&2
    exit 1
  fi
done
echo "pre-push: all checks passed"
